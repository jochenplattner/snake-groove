# ============================================================
#  Unity Project .gitignore  — адаптировано для структуры:
#  snake-groove/
#      SnakeGroove/   ← Unity проект
# ============================================================

# Unity project directories
/SnakeGroove/[Ll]ibrary/
/SnakeGroove/[Tt]emp/
/SnakeGroove/[Oo]bj/
/SnakeGroove/[Bb]uild/
/SnakeGroove/[Bb]uilds/
/SnakeGroove/[Ll]ogs/
/SnakeGroove/[Uu]ser[Ss]ettings/
/SnakeGroove/[Mm]emoryCaptures/
/SnakeGroove/[Rr]ecordings/

# Unity Package Cache (модули вроде com.unity.* внутри Library)
SnakeGroove/[Ll]ibrary/PackageCache/
SnakeGroove/[Ll]ibrary/ScriptAssemblies/
SnakeGroove/[Ll]ibrary/CacheServer/
SnakeGroove/[Ll]ibrary/Artifacts/
SnakeGroove/[Tt]estResults/

# Autogenerated JetBrains Rider plugin
/SnakeGroove/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio & Rider cache directories
.vs/
.idea/
.vscode/
.gradle/
.consulo/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Keep the standalone .NET core test project tracked for CI.
!tests/**/*.csproj

# Standalone .NET test project outputs
tests/**/bin/
tests/**/obj/
TestResults/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Logs
*.log

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/SnakeGroove/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/SnakeGroove/[Aa]ssets/[Ss]treamingAssets/aa.meta
/SnakeGroove/[Aa]ssets/[Ss]treamingAssets/aa/*

# Игнорировать собранные билды Unity
[Bb]uilds/

# ============================================================
# Notes:
#   • Эта версия учитывает, что Unity проект находится в подпапке SnakeGroove/
#   • GitHub LFS должен использоваться для ассетов: png, jpg, wav, mp3, fbx и т.д.
# ============================================================
